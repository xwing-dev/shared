{
  "name": "@xwing-dev/shared",
  "version": "1.0.2",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "description": "Shared package for tickets application",
  "author": "pavel.kazlou.dev@gmail.com",
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate:contracts": "npx protoc -I ./src/contracts/proto ./src/contracts/proto/*.proto --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./src/contracts/gen --ts_proto_opt=nestJs=true,package=omit"
  },
  "exports": {
    ".": "./dist/index.js",
    "./biome": "./biome.json",
    "./contracts": "./src/contracts"
  },
  "files": [
    "dist",
    "biome.json",
    "src/contracts/gen",
    "src/contracts/proto"
  ],
  "devDependencies": {
    "ts-node": "^10.9.2",
    "ts-proto": "^2.11.8",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@nestjs/microservices": "^11.1.21",
    "rxjs": "^7.8.2"
  }
}
